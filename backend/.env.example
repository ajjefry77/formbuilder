# Server
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=formbuilder
DB_USER=postgres
DB_PASSWORD=your_password_here

# Security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_random_hex_64_chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=change_me_to_random_hex_64_chars

# Default admin (only used on first run if no admin exists)
DEFAULT_ADMIN_PHONE=09120000000
DEFAULT_ADMIN_PASSWORD=Admin@12345
